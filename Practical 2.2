#include <stdio.h>

int main()
{
    char enrollment[20], name[50];
    char branch[20], mobile[15];
    int semester;

    printf("STUDENT RECORD MANAGEMENT SYSTEM\n");

    printf("Software Version: 1.0\n");
    printf("Academic Year: 2026-2027\n");
    printf("Institute: CHARUSAT\n");

    printf("\nEnter Enrollment Number: ");
    scanf("%s", enrollment);

    printf("Enter Student Name: ");
    scanf(" %[^\n]", name);

    printf("Enter Branch: ");
    scanf("%s", branch);

    printf("Enter Semester: ");
    scanf("%d", &semester);

    printf("Enter Mobile Number: ");
    scanf("%s", mobile);

    printf("\n----- Student Report -----\n");

    printf("Enrollment: %s\n", enrollment);
    printf("Name: %s\n", name);
    printf("Branch: %s\n", branch);
    printf("Semester: %d\n", semester);
    printf("Mobile: %s\n", mobile);

    return 0;
}
