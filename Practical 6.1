
#include <iostream>
using namespace std;

int main()
{
    int n, score[100], total = 0;
    int highest, lowest;
    string id[100], name[100];

    cout << "Enter number of participants: ";
    cin >> n;

    for (int i = 0; i < n; i++)
    {
        cout << "\nEnter Participant ID: ";
        cin >> id[i];

        cout << "Enter Name: ";
        cin >> name[i];

        cout << "Enter Score: ";
        cin >> score[i];

        total = total + score[i];
    }

    highest = lowest = score[0];

    cout << "\nID\tName\tScore\n";

    for (int i = 0; i < n; i++)
    {
        cout << id[i] << "\t" << name[i]
             << "\t" << score[i] << endl;

        if (score[i] > highest)
            highest = score[i];

        if (score[i] < lowest)
            lowest = score[i];
    }

    cout << "\nTotal Score: " << total;
    cout << "\nAverage Score: " << (float)total / n;
    cout << "\nHighest Score: " << highest;
    cout << "\nLowest Score: " << lowest;

    return 0;
}
