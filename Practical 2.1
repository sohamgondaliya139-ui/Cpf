#include <stdio.h>

int main()
{
    char enrollment[20];
    char name[50];
    char branch[20];
    int semester;
    char mobile[15];

    printf("STUDENT RECORD MANAGEMENT SYSTEM\n");

    printf("Enter Enrollment Number: ");
    scanf("%s", enrollment);

    printf("Enter Student Name: ");
    scanf(" %[^\n]", name);

    printf("Enter Branch: ");
    scanf("%s", branch);

    printf("Enter Semester: ");
    scanf("%d", &semester);

    printf("Enter Mobile Number: ");
    scanf("%s", mobile);

    printf("\n----- Student Information -----\n");

    printf("Enrollment: %s\n", enrollment);
    printf("Name: %s\n", name);
    printf("Branch: %s\n", branch);
    printf("Semester: %d\n", semester);
    printf("Mobile: %s\n", mobile);

    return 0;
}
