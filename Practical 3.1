#include <iostream>
using namespace std;

int main()
{
    int m1, m2, m3, m4, m5;
    int total;
    float average, percentage;

    cout << "Enter marks of five subjects: ";
    cin >> m1 >> m2 >> m3 >> m4 >> m5;

    total = m1 + m2 + m3 + m4 + m5;

    average = total / 5.0;
    percentage = (total / 500.0) * 100;

    cout << "\nTotal Marks = " << total << endl;
    cout << "Average = " << average << endl;
    cout << "Percentage = " << percentage << "%" << endl;

    return 0;
}
